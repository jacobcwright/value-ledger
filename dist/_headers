# Cloudflare Workers Static Assets headers. This file is not served.
# Matching rules merge, and a header set by two rules is comma-joined,
# so Cache-Control is set only on the specific paths below, never on /*.
# HTML, JS and CSS keep the platform default (revalidate on every request,
# with an ETag), which suits these unhashed filenames.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

/portraits/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/screenshots/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/og-image.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
