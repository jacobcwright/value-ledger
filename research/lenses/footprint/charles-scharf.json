  "metrics": {
    "offices": {
      "label": "Bank offices",
      "unit": "count",
      "period": "as of June 30, 2024",
      "tier": "regulator",
      "definition": "Number of office records the FDIC Summary of Deposits lists for Wells Fargo Bank, N.A. (cert 3511) in each state: 4,304 offices in 40 states and DC, of which 4,122 have FDIC branch service type 11 ('Full Service, brick and mortar office'), 83 type 12 ('Full Service, retail office'), and the rest limited-service drive-through (23), mobile/seasonal (29) and trust (30) offices."
    },
    "deposits": {
      "label": "Deposits at offices in the state",
      "unit": "currency-millions",
      "currency": "USD",
      "period": "as of June 30, 2024",
      "tier": "regulator",
      "definition": "FDIC Summary of Deposits field DEPSUMBR, 'Branch office deposits as of June 30' (FDIC variable definitions), summed by the FDIC API across the bank's offices in each state. The SOD instructions say to 'Report all amounts in thousands'; values here are the FDIC's thousands divided by 1,000. South Dakota, the bank's main-office state, shows $354.4 billion across 30 offices; the FDIC data do not say why, and the figure is not adjusted."
    },
    "occupiedSqFt": {
      "label": "Property occupied (millions of sq ft)",
      "unit": "square-feet-millions",
      "period": "as of Dec 31, 2024",
      "tier": "filing",
      "definition": "Approximate square footage of property occupied for business operations, from the 10-K's Item 2 table of top U.S. and international locations.",
      "scale": 1000000
    }
  },
