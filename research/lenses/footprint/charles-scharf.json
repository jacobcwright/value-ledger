  "metrics": {
    "offices": {
      "label": "Bank offices",
      "unit": "count",
      "period": "as of June 30, 2026",
      "tier": "regulator",
      "definition": "Number of office records the FDIC Summary of Deposits lists for Wells Fargo Bank, N.A. (cert 3511) in each state: 4,157 offices in 39 states and DC, of which 4,012 have FDIC branch service type 11 ('Full Service, brick and mortar office'), 58 type 12 ('Full Service, retail office'), and the rest limited-service drive-through (type 23, 13), mobile/seasonal (type 29, 50), trust (type 30, 23) and one type 21 office."
    },
    "deposits": {
      "label": "Deposits at offices in the state",
      "unit": "currency-millions",
      "currency": "USD",
      "period": "as of June 30, 2026",
      "tier": "regulator",
      "definition": "FDIC Summary of Deposits field DEPSUMBR, 'Branch office deposits as of June 30' (FDIC variable definitions), summed by the FDIC API across the bank's offices in each state. The SOD instructions say to 'Report all amounts in thousands'; values here are the FDIC's thousands divided by 1,000. South Dakota, the bank's main-office state, shows $464.8 billion across 30 offices; the FDIC data do not say why, and the figure is not adjusted."
    },
    "occupiedSqFt": {
      "label": "Property occupied (millions of sq ft)",
      "unit": "square-feet-millions",
      "period": "as of Dec 31, 2025",
      "tier": "filing",
      "definition": "Approximate square footage of property occupied for business operations, from the 10-K's Item 2 table of top U.S. and international locations."
    }
  },
